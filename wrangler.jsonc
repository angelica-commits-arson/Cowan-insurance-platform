{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cowan-technician-timetable",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-11-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cowan-scheduler",
      "database_id": "7e07e76d-b1fd-432e-86e5-a0e290577c77",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
